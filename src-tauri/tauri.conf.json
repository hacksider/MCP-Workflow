{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Workflow",
  "version": "0.17.3",
  "identifier": "dev.mcp-workflow.studio",
  "build": {
    "beforeDevCommand": "npm run build:helper && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCP Workflow",
        "width": 1480,
        "height": 960,
        "minWidth": 1050,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../COMMERCIAL-LICENSE.md": "COMMERCIAL-LICENSE.md",
      "resources/claude-runner.mjs": "claude-runner.mjs",
      "resources/CLAUDE-SDK-NOTICE.md": "CLAUDE-SDK-NOTICE.md"
    }
  }
}
